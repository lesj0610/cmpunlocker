--- a/src/nvidia/src/kernel/gpu/gpu.c	2026-08-26 12:46:10.121250423 +0900
+++ b/src/nvidia/src/kernel/gpu/gpu.c	2026-08-26 12:46:10.149250543 +0900
@@ -911,6 +911,23 @@
     pGpu->idInfo.PCISubDeviceID = pGpu->pChipInfo->pciSubDeviceId;
     pGpu->idInfo.PCIRevisionID  = pGpu->pChipInfo->pciRevisionId;
 
+    //
+    // CMP SKUs report isCmpSku=TRUE from GSP. Userspace reads it back through
+    // NV2080_CTRL_GPU_INFO_INDEX_CMP_SKU and CUPTI turns it into
+    // CUPTI_ERROR_CMP_DEVICE_NOT_SUPPORTED / ERR_NVCMPGPU, which kills all
+    // activity tracing and HW counter collection. The perf counters are
+    // functional on these parts, so drop the marker.
+    //
+    {
+        NvU32 cmpDevId = pGpu->pChipInfo->pciDeviceId >> 16;
+        if (cmpDevId == 0x20C2 || cmpDevId == 0x2082)
+        {
+            pGpu->pChipInfo->isCmpSku = NV_FALSE;
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: cleared isCmpSku for devId 0x%04x\n", cmpDevId);
+        }
+    }
+
 done:
     if (status != NV_OK)
